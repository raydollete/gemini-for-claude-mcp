# Required: Google Cloud project ID hosting Vertex AI
# Enable the Vertex AI API: https://cloud.google.com/vertex-ai/docs/start/cloud-environment
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# Optional: Vertex AI region (default: global)
# IMPORTANT: Newer preview models (e.g. gemini-3-pro-preview, gemini-3.1-pro-preview)
# are only served from the `global` location. Regional endpoints like `us-central1`
# will return 404 for those models. Use a regional value only if every model you
# plan to call is available in that region.
# See: https://cloud.google.com/vertex-ai/generative-ai/docs/learn/locations
GOOGLE_CLOUD_LOCATION=global

# Optional: Path to a service-account JSON key.
# If unset, Application Default Credentials are used
# (run `gcloud auth application-default login` for local dev).
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Required: Default Gemini model to use
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Optional: Max output tokens injected into requests (default: 65536)
GEMINI_MAX_OUTPUT_TOKENS=65536

# Optional: Request timeout in milliseconds (default: 300000)
GEMINI_TIMEOUT_MS=300000

# Optional: Environment mode (development | production | test)
NODE_ENV=development

# Optional: Log level (fatal | error | warn | info | debug | trace)
LOG_LEVEL=info
